    <!-- help -->
    <string name="help_ops_title">How to use</string>
    <string-array name="help_ops_lines">
        <item>Swipe right on a row: cross it off; swipe right again to undo</item>
        <item>Tap or swipe left on a row: edit its text</item>
        <item>Tap the doodle before a row: select it, then tap another row to swap positions</item>
        <item>Bottom right +: add; press Enter to save and keep adding</item>
        <item>Turn pages: swipe up/down, or use the device page / volume keys</item>
        <item>Bottom left ⋯: settings (WebDAV, archive, help)</item>
        <item>Finished notes stay in place; use Settings → Archive finished to move them to the archive</item>
        <item>Tap an archived note to restore it or delete it forever</item>
        <item>Font: Settings → Font switches between system and pixel fonts</item>
        <item>Language: Settings → Language switches between system, English and 简体中文</item>
    </string-array>
    <string name="help_sync_title">Sync setup</string>
    <string-array name="help_sync_lines">
        <item>Settings → WebDAV: enter your NAS WebDAV address</item>
        <item>Example: http://192.168.1.10:5005/</item>
        <item>Add username and password; the remote file defaults to EinkMemo/notes.json, and directories are created automatically</item>
        <item>Tap Test connection first; when it succeeds, tap Save</item>
        <item>Settings → Sync now: manual sync only; the app never syncs automatically on launch</item>
        <item>If both sides changed, a dialog asks which copy to keep</item>
    </string-array>

